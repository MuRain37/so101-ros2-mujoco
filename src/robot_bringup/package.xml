<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files that compose SO-101 description, hardware bridge, and simulation components.</description>
  <maintainer email="murain@example.com">murain</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>so101_leader_bridge</exec_depend>
  <exec_depend>mujoco_sim</exec_depend>
  <exec_depend>vla_dataset</exec_depend>
  <exec_depend>robot_policy</exec_depend>
  <exec_depend>teleop_retargeting</exec_depend>
  <exec_depend>robot_adapters</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
