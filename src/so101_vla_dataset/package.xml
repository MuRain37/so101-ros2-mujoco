<?xml version="1.0"?>
<package format="3">
  <name>so101_vla_dataset</name>
  <version>0.1.0</version>
  <description>Service-controlled rosbag2 episode recorder for SO-101 VLA datasets.</description>
  <maintainer email="murain@example.com">murain</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_srvs</depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
